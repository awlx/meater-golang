# Local release configuration for ios/release.sh.
#
#   cp release.env.example release.env   # release.env is gitignored — NEVER commit it
#
# The App Store Connect API key (.p8) itself lives OUTSIDE the repo, in
# ~/.appstoreconnect/private_keys/ (Apple's standard lookup location).

# Your Apple Developer Team ID (Membership page on developer.apple.com).
DEVELOPMENT_TEAM=ABCDE12345

# App Store Connect API key (Users and Access → Integrations → App Store
# Connect API → Team Keys → Generate API Key, role "App Manager").
# The Key ID (10 chars) and the Issuer ID (UUID shown at the top of that page):
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Where the downloaded AuthKey_<ASC_KEY_ID>.p8 lives. Defaults to
# ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8 if unset.
#ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Optional overrides, otherwise taken from project.yml / git:
#MARKETING_VERSION=1.0
#BUILD_NUMBER=42
