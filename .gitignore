# Compiled binaries
/meater
/meater-golang
*.exe
*.test
*.out

# ACME / TLS cache
/acme-certs/

# PlatformIO build output and downloaded toolchains (firmware/)
.pio/

# SQLite cook-history database (created at runtime)
*.db
*.db-wal
*.db-shm
/data/

# Local screenshots scratch (keep docs/screenshot.png tracked)
# (nothing excluded here by default)

# Python bytecode from the Home Assistant integration (custom_components/)
__pycache__/
*.py[cod]

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# iOS release chain — secrets and build products must never be committed
ios/release.env
# Generated by xcodegen from ios/project.yml; may embed the team ID
ios/*.xcodeproj/
*.p8
*.mobileprovision
*.ipa
*.xcarchive
ios/build/
xcuserdata/
*.xcuserstate
